{
  "name": "appclase",
  "version": "0.2.0",
  "description": "Índice unificado del curso: asignaturas, temas, ficheros y entregas",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "electron-vite build && node scripts/e2e.cjs",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "release": "npm version patch --no-git-tag-version && git commit -am \"Nueva versión\" && git push"
  },
  "author": "AppClase",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
